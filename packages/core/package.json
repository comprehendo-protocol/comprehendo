{
  "name": "@comprehendo/core",
  "version": "0.0.1",
  "description": "Comprehendo provider SDK: marker/probe, twin builder, docs engine, config loader (JavaScript). Internal, unpublished workspace package; the root comprehendo npm package re-exports this package's build unchanged (see the repository root's package.json and index.js).",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "keywords": [
    "comprehendo",
    "provider-sdk",
    "marker",
    "twin"
  ],
  "author": "TheDecipherist",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comprehendo-protocol/comprehendo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/comprehendo-protocol/comprehendo#readme",
  "bugs": {
    "url": "https://github.com/comprehendo-protocol/comprehendo/issues"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.0.0",
    "@types/node": "^22.9.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.67.0",
    "eslint-plugin-unused-imports": "^4.1.4"
  }
}
