    "url": "https://github.com/TheDecipherist/comprehendo/issues"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.0.0",
    "@types/node": "^22.9.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.67.0",
    "eslint-plugin-unused-imports": "^4.1.4"
